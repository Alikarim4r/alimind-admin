<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode variants. The app is dark-only, so these mirror the light
         definitions exactly — they exist so the OS does not substitute its
         own default window background in night mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
